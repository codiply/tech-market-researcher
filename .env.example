MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=<your db password>
MLFLOW_DB_NAME=mlflow

# MinIO (S3-compatible object storage for MLflow artifacts). The server talks
# to MinIO over the compose network; clients never need these credentials.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345

MLFLOW_SERVER_URI=http://localhost:5000
# Optional: pgAdmin UI password (default: pgadmin12345)
# PGADMIN_PASSWORD=pgadmin12345
MLFLOW_EXPERIMENT=tech-market-researcher-001
# Model providers in a private network (e.g. OMLX_BASE_URL pointing to a private IP over http):
# MLFLOW_GATEWAY_API_BASE_ALLOWED_SCHEMES is a comma-separated list of allowed URL schemes
# (e.g. "http,https" to add "http") and set MLFLOW_GATEWAY_API_BASE_ALLOW_PRIVATE_IPS="true" to enable reaching them.
MLFLOW_GATEWAY_API_BASE_ALLOWED_SCHEMES="https"
MLFLOW_GATEWAY_API_BASE_ALLOW_PRIVATE_IPS="false"

OMLX_BASE_URL=http://<oMLX server private IP>:11436/v1
OMLX_API_KEY=<your key>

# Used for search
TAVILY_API_KEY=<your key>

# Local SearXNG instance (see docker/docker-compose.yml)
SEARXNG_URL=http://localhost:8384
# Optional: SearXNG server secret (default: searxng-local-development-secret)
# SEARXNG_SECRET=
