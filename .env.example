MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=<your db password>
MLFLOW_DB_NAME=mlflow

# Phoenix database (Postgres) credentials
PHOENIX_DB_USER=phoenix
PHOENIX_DB_PASSWORD=<your db password>
PHOENIX_DB_NAME=phoenix

# Agent database (Postgres) credentials
AGENT_DB_USER=agent
AGENT_DB_PASSWORD=<your db password>
AGENT_DB_NAME=agent

# Phoenix REST API base URL (used by the bootstrap to push datasets)
PHOENIX_SERVER_URI=http://localhost:6006

# MinIO (S3-compatible object storage for MLflow artifacts). The server talks
# to MinIO over the compose network; clients never need these credentials.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345

MLFLOW_SERVER_URI=http://localhost:5000
# Host name used to reach this machine from outside (e.g. Tailscale)
# TAILSCALE_HOST_NAME=<your tailscale host name>
# "Container" because it is the MLflow gateway host as seen from inside any of the
# containers (they resolve other containers by their name): used by Phoenix providers.
MLFLOW_AI_GATEWAY_CONTAINER_BASE_URL=http://mlflow_server:5000/gateway/mlflow/v1
# Optional: pgAdmin UI password (default: pgadmin12345)
# PGADMIN_PASSWORD=pgadmin12345
# Model providers in a private network (e.g. OMLX_BASE_URL pointing to a private IP over http):
# MLFLOW_GATEWAY_API_BASE_ALLOWED_SCHEMES is a comma-separated list of allowed URL schemes
# (e.g. "http,https" to add "http") and set MLFLOW_GATEWAY_API_BASE_ALLOW_PRIVATE_IPS="true" to enable reaching them.
MLFLOW_GATEWAY_API_BASE_ALLOWED_SCHEMES="https"
MLFLOW_GATEWAY_API_BASE_ALLOW_PRIVATE_IPS="false"

# Phoenix (see docker/docker-compose.yml). arize-otel's register() exports
# the agent's LangChain spans to this OTLP gRPC collector endpoint. Phoenix's
# auth is disabled, so no PHOENIX_API_KEY is needed.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
# Optional: encrypts credentials saved in the Phoenix UI (default:
# phoenix-local-development-secret)
# PHOENIX_ENCRYPTION_SECRET=

OMLX_BASE_URL=http://<oMLX server private IP>:11436/v1
OMLX_API_KEY=<your key>

# Used for search
TAVILY_API_KEY=<your key>

# Local SearXNG instance (see docker/docker-compose.yml)
SEARXNG_URL=http://localhost:8384
# Optional: SearXNG server secret (default: searxng-local-development-secret)
# SEARXNG_SECRET=

# This must be an environment variable: the loader runs before the config is loaded,
# so the switch cannot live in the config itself
# (a broken config would otherwise fail before you can enable the dump to debug it).
# Optional: set to "true" or "1" to dump rendered configs into .debug/config/ for debugging.
# DEBUG_DUMP_RENDERED_CONFIGS=true
