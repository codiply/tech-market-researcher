# Environment files (secrets) — ignores .env anywhere in the repo,
# but always tracks the template
.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
.mypy_cache/
.pytest_cache/

# MLflow local fallback DB (created if a client runs without a tracking URI)
mlflow.db
mlruns/

# Debugging artifacts
.debug/

# Agent local state
.pi/

# Local config overrides (never committed)
config/**/*.local.yaml
