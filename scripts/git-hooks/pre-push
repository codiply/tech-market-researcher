#!/bin/sh
# Disallow force pushes (non-fast-forward) and branch deletion on main.
# Normal pushes are unaffected.
ZERO=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
    ref_name=${remote_ref#refs/heads/}

    if [ "$ref_name" = "main" ]; then
        if [ "$local_sha" = "$ZERO" ]; then
            echo "pre-push: deleting main is not allowed." >&2
            exit 1
        fi
        if [ "$remote_sha" != "$ZERO" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
            echo "pre-push: force push to main is not allowed (non-fast-forward)." >&2
            exit 1
        fi
    fi
done
exit 0
