{%- for time_zone in ["Europe/Athens", "Europe/London", "America/Los_Angeles"] %}
- input:
    messages:
    - role: user
      content: What is the date and time now?
    context:
      time_zone: {{ time_zone }}
  guidelines:
  - The agent must use the tool `current_datetime` and the response must contain the string `({{ time_zone }})`.
  tags:
    capability_under_test: current_datetime
{%- endfor %}
