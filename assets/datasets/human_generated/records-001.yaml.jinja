{%- for time_zone in ["Europe/Athens", "Europe/London", "America/Los_Angeles"] %}
- input:
    messages:
    - role: user
      content: What is the date and time now?
    context:
      time_zone: {{ time_zone }}
  guidelines:
  - The response must contain the string `({{ time_zone }})`.
  expected_tool_calls:
  - name: current_datetime
  tags:
    capability_under_test: current_datetime
{%- endfor %}
